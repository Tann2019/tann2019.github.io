{
  "name": "bigsky-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Guestbook notes and live cursors for the Big Sky desktop.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute bigsky --local --file=schema.sql",
    "db:remote": "wrangler d1 execute bigsky --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  }
}
