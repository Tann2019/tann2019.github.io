---
// The page's header: a glass panel over the sky, like the desktop's name panel. Put it in ArticleLayout's head slot.
// An optional aside sits right of the title on wide screens; anything else (a StatRow) follows the meta. A title with
// markup in it goes in the title slot instead of the prop.
import Seps from './Seps.astro';

interface Props {
  title?: string;
  lede?: string;
  /** A size down, for a title as long as a post's. */
  small?: boolean;
  /** Year, role, platform, status and the like. A value with a datetime prints as a <time>. */
  meta?: { label: string; value: string; datetime?: string }[];
  /** The product's own site, as a button under the lede. */
  site?: { href: string; name: string };
  /** An App Store listing, as a second button. */
  appStore?: string;
}
const { title, lede, small = false, meta = [], site, appStore } = Astro.props;
---

<header class="ahead">
  <div class="ahead-main">
    <h1 class:list={['ahead-title', { 'is-small': small }]}><slot name="title">{title}</slot></h1>
    {lede && <p class="ahead-lede">{lede}</p>}
    {(site || appStore) && (
      <p class="ahead-actions">
        {site && <a class="btn" href={site.href} target="_blank" rel="noopener">{site.name}</a>}
        {appStore && <a class="btn" href={appStore} target="_blank" rel="noopener">App Store</a>}
      </p>
    )}
  </div>
  {Astro.slots.has('aside') && (
    <div class="ahead-aside">
      <slot name="aside" />
    </div>
  )}
  {meta.length > 0 && (
    <dl class="ahead-meta">
      {meta.map((m) => (
        <div>
          <dt>{m.label}</dt>
          <dd>{m.datetime ? <time datetime={m.datetime}>{m.value}</time> : <Seps text={m.value} />}</dd>
        </div>
      ))}
    </dl>
  )}
  <slot />
</header>
