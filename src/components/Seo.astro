---
// Search and social metadata, shared by BaseLayout and the desktop homepage.
import { toolkit } from '../redesign/content';
import ogCards from '../redesign/og-cards.json';

interface Props {
  title: string;
  description?: string;
  /** Path or absolute URL of the social share card. Falls back to the site card. */
  image?: string;
  imageAlt?: string;
  /** 'website' for index-style pages, 'article' for case studies and posts. */
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  /** Extra JSON-LD graph nodes contributed by the page. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const SITE = 'https://tannersteorts.com';
const SITE_NAME = 'Tanner Steorts';
const GITHUB = 'https://github.com/Tann2019';
const DEFAULT_IMAGE = '/og/default.png';
const DEFAULT_DESCRIPTION =
  'Tanner Steorts, a software engineer in Billings, Montana, builds real-time apps like DisDubs and Gridiron Duels. His homepage is an interactive desktop.';
/** Describes /og/default.png. Keep the two in step. */
const DEFAULT_IMAGE_ALT =
  'Tanner Steorts, software engineer in Billings, Montana, on a desktop under a mountain sky at golden hour.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  keywords = [],
  schema,
  noindex = false,
} = Astro.props;
// The default alt describes the default card only. A page with its own card and no alt gets its title.
const imageAlt = Astro.props.imageAlt ?? (Astro.props.image ? title : DEFAULT_IMAGE_ALT);

const currentPath = Astro.url.pathname;
// Pages build to directory format, so the served URL keeps its trailing slash.
// The canonical has to name the URL that actually returns 200, not a redirect.
const canonicalPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url).href;
// Cards from `npm run og` carry their hash, so a regenerated card gets a URL that feeds haven't cached.
const card = /^\/og\/(.+)\.png$/.exec(image)?.[1];
const version = card ? (ogCards as Record<string, string>)[card] : undefined;
const imageURL = new URL(version ? `${image}?v=${version}` : image, Astro.site ?? Astro.url).href;

const person = {
  '@type': 'Person',
  '@id': `${SITE}/#person`,
  name: 'Tanner Steorts',
  givenName: 'Tanner',
  familyName: 'Steorts',
  url: `${SITE}/`,
  description: 'Software engineer in Billings, Montana who builds real-time apps people use together.',
  jobTitle: 'Software Engineer',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Rocky Mountain College' },
  email: 'mailto:tanner.steorts@icloud.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Billings',
    addressRegion: 'MT',
    addressCountry: 'US',
  },
  knowsAbout: toolkit.flatMap((group) => group.items),
  sameAs: [GITHUB],
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: `${SITE}/`,
  name: SITE_NAME,
  description: DEFAULT_DESCRIPTION,
  publisher: { '@id': `${SITE}/#person` },
  inLanguage: 'en-US',
};

const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, website, ...pageSchema],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Tanner Steorts" />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<link rel="me" href={GITHUB} />

<!-- Open Graph: what LinkedIn, Facebook, Slack and Discord read. -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Tanner Steorts" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:secure_url" content={imageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />
{type === 'article' && <meta property="article:author" content="Tanner Steorts" />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="alternate" type="application/rss+xml" title="Tanner Steorts — Blog" href="/rss.xml" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
