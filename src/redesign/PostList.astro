---
// Every post, newest first: the desktop's writing window and /blog/. Styled by .posts in css/doc.css.
import { postDate, type Post } from '../data/posts';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="posts">
  {posts.map((post) => (
    <li>
      <a href={`/blog/${post.id}/`}>
        <span class="post-title">{post.data.title}</span>
        <span class="post-desc">{post.data.description}</span>
        <time class="doc-meta" datetime={post.data.pubDate.toISOString().slice(0, 10)}>{postDate.format(post.data.pubDate)}</time>
      </a>
    </li>
  ))}
</ul>
