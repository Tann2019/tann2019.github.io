---
// The scene behind the desktop: sky layers, sun, moon and stars, then canvases for clouds, land and
// precipitation. sky.ts, land.ts and weather.ts paint into these. Shared by the homepage, the case studies and the
// share cards.

interface Props {
  /** The cloud and precipitation canvases. Pages that run no weather leave them out. */
  weather?: boolean;
}
const { weather = true } = Astro.props;

// Seeded so the poster is identical on every build.
function seeded(seed: number) {
  let s = seed;
  return () => (s = (s * 16807) % 2147483647) / 2147483647;
}
const rand = seeded(1882);

const stars = Array.from({ length: 120 }, () => ({
  x: +(rand() * 1600).toFixed(1),
  y: +(Math.pow(rand(), 1.5) * 620).toFixed(1),
  r: +(0.6 + rand() * 1.5).toFixed(2),
}));
---

<div id="sky-base" aria-hidden="true"></div>
<div id="sky" aria-hidden="true"></div>
<svg id="wallpaper" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <radialGradient id="sun-glow">
      <stop offset="0" stop-color="#fffbe8" stop-opacity="0.85"></stop>
      <stop offset="0.18" stop-color="#fff3d0" stop-opacity="0.4"></stop>
      <stop offset="0.45" stop-color="#ffe6b8" stop-opacity="0.12"></stop>
      <stop offset="1" stop-color="#ffe0b0" stop-opacity="0"></stop>
    </radialGradient>
    <mask id="moon-mask" maskUnits="userSpaceOnUse" x="-40" y="-40" width="80" height="80">
      <rect x="-40" y="-40" width="80" height="80" fill="#fff"></rect>
      <circle class="moon-shadow" r="27" fill="#000"></circle>
    </mask>
  </defs>

  <g id="sky-stars">
    {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#fff" opacity={0.5 + s.r / 4} />)}
  </g>

  <g id="sky-moon">
    <circle r="26" data-ink="moon" mask="url(#moon-mask)"></circle>
  </g>

  <g id="sky-sun">
    <circle r="120" fill="url(#sun-glow)"></circle>
    <circle r="17" data-ink="sun"></circle>
  </g>

</svg>
{weather && <canvas id="clouds" aria-hidden="true"></canvas>}
<canvas id="land" aria-hidden="true"></canvas>
{weather && <canvas id="precip" aria-hidden="true"></canvas>}
