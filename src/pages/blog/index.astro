---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleHead from '../../components/article/ArticleHead.astro';
import PostList from '../../redesign/PostList.astro';
import { getPosts } from '../../data/posts';

const posts = await getPosts();
---

<ArticleLayout
  title="Blog — Tanner Steorts"
  description="Posts by Tanner Steorts on real-time apps, hardware side projects and how he builds them."
  name="Writing"
  app="writing"
  icon="notebook"
>
  <ArticleHead slot="head">
    <Fragment slot="title">Thoughts &<br /><em>writings</em></Fragment>
  </ArticleHead>

  {posts.length === 0 ? <p>No posts yet. Check back soon.</p> : <PostList posts={posts} />}
</ArticleLayout>
