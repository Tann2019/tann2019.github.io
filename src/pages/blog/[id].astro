---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleHead from '../../components/article/ArticleHead.astro';
import PrevNext from '../../components/article/PrevNext.astro';
import { getPosts, postDate, shortTitle, type Post } from '../../data/posts';
import ogCards from '../../redesign/og-cards.json';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags = [] } = post.data;

// Read time at ~225 words a minute, the rate the posts have always shown. wordCount also goes in the JSON-LD.
const body = post.body ?? '';
const wordCount = body.split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.ceil(wordCount / 225));

// Results cut titles off around 60 characters; og:site_name already carries the name.
const withName = `${title} — Tanner Steorts`;
const pageTitle = withName.length > 60 ? title : withName;

// The post's share card from `npm run og`, once generated. Until then Seo falls back to the site card.
const card = `blog/${post.id}`;
const cardProps = card in ogCards
  ? {
      image: `/og/${card}.png`,
      imageAlt: `${title}, a blog post from ${postDate.format(pubDate)}, in a window on a desktop under a mountain sky.`,
    }
  : {};

const day = (d: Date) => d.toISOString().slice(0, 10);
const meta = [
  { label: 'Published', value: postDate.format(pubDate), datetime: day(pubDate) },
  ...(updatedDate ? [{ label: 'Updated', value: postDate.format(updatedDate), datetime: day(updatedDate) }] : []),
  { label: 'Length', value: `${readTime} min read` },
];
const link = (p?: Post) => p && { href: `/blog/${p.id}/`, title: p.data.title };
---

<ArticleLayout
  title={pageTitle}
  description={description}
  {...cardProps}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
  keywords={tags}
  schema={{
    '@type': 'BlogPosting',
    '@id': `https://tannersteorts.com/blog/${post.id}/#post`,
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: new URL(cardProps.image ?? '/og/default.png', 'https://tannersteorts.com').href,
    wordCount,
    keywords: tags.join(', '),
    inLanguage: 'en-US',
    author: { '@id': 'https://tannersteorts.com/#person' },
    publisher: { '@id': 'https://tannersteorts.com/#person' },
    isPartOf: { '@id': 'https://tannersteorts.com/#website' },
    mainEntityOfPage: `https://tannersteorts.com/blog/${post.id}/`,
  }}
  name={shortTitle(post)}
  parent={{ name: 'Writing', href: '/blog/' }}
  app="writing"
  icon="notebook"
>
  <ArticleHead slot="head" title={title} lede={description} meta={meta} small>
    {tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
  </ArticleHead>

  <Content />

  <PrevNext kind="writing" prev={link(older)} next={link(newer)} />
</ArticleLayout>

<style>
  /* The post's tags, as chips under the meta. A chip doesn't break, so "react-native" stays whole. Darker than the
     panel, not lighter: a light fill took the text under 4.5:1 on the midday sky. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .tags li {
    padding: 3px 11px 2px;
    border-radius: 999px;
    background: rgb(var(--bg-rgb) / 0.3);
    border: 1px solid rgb(var(--fg-rgb) / 0.16);
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
