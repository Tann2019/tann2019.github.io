---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import ArticleHead from '../components/article/ArticleHead.astro';
import WorkHistory from '../redesign/WorkHistory.astro';
---

<ArticleLayout
  title="About — Tanner Steorts"
  description="Tanner Steorts, a full-stack developer in Billings, Montana: Laravel and React apps with real-time features, education, goals and links."
  name="About"
  app="work"
  icon="clipboard"
>
  <ArticleHead
    slot="head"
    lede="Full-stack developer specializing in Laravel + React applications with real-time capabilities. I build products that are fast, polished, and fun to use."
  >
    <Fragment slot="title">Building software<br />that <em>matters</em></Fragment>

    <dl class="ahead-meta about-meta">
      <div>
        <dt>Education</dt>
        <dd>B.S. Computer Science<span>Rocky Mountain College</span><span>2019 — 2022</span></dd>
      </div>
      <div>
        <dt>Currently</dt>
        <dd>Support Engineer<span>Givebutter</span></dd>
      </div>
      <div>
        <dt>Links</dt>
        <dd class="about-links">
          <a href="https://github.com/Tann2019" target="_blank" rel="noopener">GitHub</a>
          <a href="mailto:tanner.steorts@icloud.com">Email</a>
        </dd>
      </div>
    </dl>
  </ArticleHead>

  <p>
    My career is driven by a strong focus on innovation and problem-solving,
    enabling me to tackle complex challenges with creative and effective approaches.
    I am committed to continuously learning and refining my skills.
  </p>
  <p>
    With a track record of delivering high-quality results, I thrive in dynamic
    environments where I can contribute to the success of ambitious projects and
    initiatives. Currently based in Billings, Montana.
  </p>

  <h2>2026 Goals</h2>
  <ul>
    <li>Ship Gridiron Duels to the App Store and Play Store</li>
    <li>Contribute to open-source Laravel packages</li>
    <li>Write technical posts about real-time app architecture and game design with Laravel</li>
  </ul>

  <h2>Work history</h2>
  <WorkHistory />
</ArticleLayout>

<style>
  /* The old sidebar's facts as the header's meta: the first line bold, the rest under it. */
  .about-meta dd span {
    display: block;
    font-weight: 400;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
  }

  /* Near-white like the rest of the panel's small print, which the accent can't match for contrast (see .ahead). */
  .about-links a {
    color: var(--fg);
  }
</style>
