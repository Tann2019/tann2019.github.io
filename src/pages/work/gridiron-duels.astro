---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleHead from '../../components/article/ArticleHead.astro';
import StatRow from '../../components/article/StatRow.astro';
import Chapter from '../../components/article/Chapter.astro';
import Figure from '../../components/article/Figure.astro';
import KeyRows from '../../components/article/KeyRows.astro';
import Ledger from '../../components/article/Ledger.astro';
import Note from '../../components/article/Note.astro';
import PrevNext from '../../components/article/PrevNext.astro';
import { neighbours } from '../../data/case-studies';
import { gridiron } from '../../data/gridiron';
import draftRoom from '../../assets/work/gridiron/draft-room.png';
import results from '../../assets/work/gridiron/results.png';
import profile from '../../assets/work/gridiron/profile.png';
import iosDraft from '../../assets/work/gridiron/ios-draft.png';

const services = [
  { name: 'CoinService',         desc: 'Atomic balance transactions, wager escrow with house rake, and Stripe-powered coin purchases. Every line item logged for auditability.' },
  { name: 'BattlePassService',   desc: '50-tier seasonal progression with free and premium tracks. XP funnels in from wins, drafts, and missions; resets each season with new content.' },
  { name: 'CosmeticShopService', desc: 'Daily rotating shop selling name colors, titles, profile borders, and banners. Cosmetic only — no pay-to-win.' },
  { name: 'MissionService',      desc: 'Daily and weekly objectives that feed XP into the battle pass and coins into the wallet. Resets via the scheduler.' },
  { name: 'RankedService',       desc: 'Elo-based MMR across 9 tiers from Iron to Hall of Fame. Matchmaking widens the skill window every 5 seconds until a match is found.' },
];

const schedule: [string, string, string][] = [
  ['Weekly',     'Sleeper API sync',     'Pull latest NFL player and schedule data'],
  ['Daily',      'Mission reset',        'Roll new daily objectives'],
  ['Daily',      'Shop rotation',        'Refresh cosmetic shop inventory'],
  ['Daily',      'Battle pass check',    'Process tier rewards and season transitions'],
  ['Every 5s',   'Matchmaking queue',    'Match ranked players, expanding window'],
  ['Every 30s',  'Timer safety net',     'Auto-pick for disconnected players'],
  ['Every 30m',  'Stale game cleanup',   'Close abandoned games and refund wagers'],
  ['Wednesdays', 'Weekly challenge',     'Generate new challenge with a random team pool'],
  ['Week-end',   'Leaderboard snapshot', 'Lock results and distribute payouts'],
];

// ------------------------------ SEO ------------------------------
const pageURL = `https://tannersteorts.com${gridiron.href}`;

// ArticleLayout adds the BreadcrumbList.
const schema = {
  '@type': 'TechArticle',
  '@id': `${pageURL}#article`,
  headline: 'Gridiron Duels — A Real-Time Fantasy Football Draft Platform',
  description:
    'A real-time fantasy football draft platform built end to end across web, mobile, and a service-oriented Laravel backend.',
  articleSection: 'Case Study',
  image: 'https://tannersteorts.com/og/gridiron-duels.png',
  inLanguage: 'en-US',
  datePublished: gridiron.published,
  dateModified: gridiron.modified,
  author: { '@id': 'https://tannersteorts.com/#person' },
  publisher: { '@id': 'https://tannersteorts.com/#person' },
  isPartOf: { '@id': 'https://tannersteorts.com/#website' },
  mainEntityOfPage: pageURL,
};
---

<ArticleLayout
  title="Gridiron Duels — A Real-Time Fantasy Football Draft Platform"
  description="Case study for Gridiron Duels: a real-time fantasy football draft platform built end to end across web, mobile, and a service-oriented Laravel backend."
  image="/og/gridiron-duels.png"
  imageAlt="Gridiron Duels, real-time fantasy football drafts, in a window on a desktop on a sunny afternoon: 3,400+ players, 1,041,000+ picks made."
  type="article"
  publishedTime={gridiron.published}
  modifiedTime={gridiron.modified}
  keywords={[
    'real-time draft',
    'fantasy football platform',
    'Laravel',
    'WebSockets',
    'mobile app',
    'engineering case study',
    'Tanner Steorts',
  ]}
  schema={schema}
  name={gridiron.title}
  app={gridiron.app}
  icon={gridiron.icon}
>
  <ArticleHead slot="head" title={gridiron.title} lede={gridiron.lede} meta={gridiron.meta} site={gridiron.site}>
    <StatRow stats={gridiron.stats} />
  </ArticleHead>

  <p class="lead">
    Fantasy football lives or dies on the draft. The instant someone's connection
    drops, a turn timer skips, or a CPU pick feels robotic, the whole illusion
    collapses. Gridiron Duels is built around the idea that the draft <em>is</em>
    the product — and everything else, scoring, leaderboards, cosmetics, the meta,
    is scaffolding that holds the moment together.
  </p>

  <Figure
    src={draftRoom}
    n={1}
    title="Draft room"
    alt="The web draft room: two nine-player rosters side by side, this round's NFL team (SF) between them"
  >
    The live draft room. Same state, every device.
  </Figure>

  <Chapter numeral="I" title="The roster behind the roster">
    <p>
      Two stacks under one roof. Public-facing pages — homepage, leaderboard,
      marketing — are server-rendered Blade for fast first paint and clean SEO.
      The interactive surfaces — draft room, shop, achievements — are React /
      Inertia, sharing auth state through middleware so users glide between
      server-rendered and SPA pages without ever feeling the seam.
    </p>

    <KeyRows rows={gridiron.stack} />
  </Chapter>

  <Chapter numeral="II" title="The engine that orchestrates the draft">
    <p>
      <code>DraftEngine</code> is a single service class that
      owns the full game lifecycle: create, join, ready-up, pick, score,
      complete. Every state transition broadcasts an event —
      <code>PlayerDrafted</code>,
      <code>TurnUpdated</code>,
      <code>GameCompleted</code> — through Laravel Reverb. Web
      clients listen via Laravel Echo, mobile clients via
      <code>pusher-js</code>. Same channels, identical events,
      one source of truth.
    </p>

    <Note>
      Turn timers run client-side for snappy UX, with a 30-second backend
      sweep that auto-picks for any player whose timer expired while
      disconnected. Two layers, one consistent state.
    </Note>

    <p>
      A player can start a draft on their laptop and a friend can join from
      their phone mid-pick. Same lobby, same turn order, same animations.
      That parity is enforced everywhere downstream — there is no <em>mobile
      version</em> of the draft, only the draft as accessed from a phone.
    </p>

    <Figure
      n={2}
      title="Draft vs CPU"
      video={{ src: '/work/gridiron-duels/draft-loop.mp4', poster: '/work/gridiron-duels/draft-poster.webp', width: 540, height: 556 }}
      alt="Picks landing on both rosters in turn against the CPU, from round 1 to round 5"
    >
      A draft against the CPU, pick by pick.
    </Figure>
  </Chapter>

  <Chapter numeral="III" title="Modes by composition, not by branch">
    <p>
      Games are assembled from two pieces. <strong>GameFormat</strong> defines
      structure — 1v1, 2v2 teams, League up to sixteen — and decides player
      count, draft order, and scoring rules. <strong>Modifiers</strong> stack on
      top: CPU fill, Crazy Mode randomized scoring, Time Machine using past
      NFL seasons. Add a new modifier and the core draft logic doesn't move.
    </p>

    <!-- Two halves, so a narrow window breaks the line at the equals sign and nowhere else. -->
    <div class="formula">
      <span class="formula-side">
        <span class="formula-token">Format</span>
        <span class="formula-op">×</span>
        <span class="formula-token">Modifier set</span>
      </span>
      <span class="formula-side">
        <span class="formula-op">=</span>
        <span class="formula-token formula-result">Game</span>
      </span>
    </div>

    <Figure
      src={results}
      n={3}
      title="Results"
      wide={false}
      alt="The results screen after a 1v1: the winner's banner, the two totals, and each roster's picks with their points"
    >
      Results: every pick scored, totals compared.
    </Figure>
  </Chapter>

  <Chapter numeral="IV" title="An economy split into focused services">
    <p>
      Five services, five domains, one shared coin. Every service owns its
      slice and nothing else, which keeps the failure modes small and the
      tests narrow.
    </p>

    <ol class="services">
      {services.map((s, i) => (
        <li class="service">
          <span class="service-n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.name}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>

    <Figure
      src={profile}
      n={4}
      frame="phone"
      alt="The iOS profile: level 20 with its XP bar, 47 wins and 46 losses, then match history, achievements, battle pass, missions and cosmetics"
    >
      Profile: level, XP, record. Battle pass, missions and cosmetics one tap in.
    </Figure>
  </Chapter>

  <Chapter numeral="V" title="The schedule that runs the league">
    <p>
      Nine scheduled tasks keep Gridiron Duels alive between human inputs.
      They roll missions, rotate the shop, sweep abandoned games, generate
      weekly challenges, and snapshot leaderboards on time, every time.
    </p>

    <Ledger head={['Frequency', 'Task', 'Purpose']} rows={schedule} />
  </Chapter>

  <Chapter numeral="VI" title="One game, every device">
    <p>
      The Expo app talks to a dedicated <code>api/v1</code>
      route group — sixteen controllers that mirror the web experience.
      Auth uses Laravel Sanctum tokens stored in
      <code>expo-secure-store</code>; broadcasting auth has
      its own endpoint, so mobile clients connect to the same Reverb
      channels as web users and receive identical events.
    </p>
    <p>
      There is no second backend, no parallel implementation, no &ldquo;mobile
      mode.&rdquo; The phone is just another window into the same draft.
    </p>

    <Figure
      src={iosDraft}
      n={5}
      frame="phone"
      alt="The iOS draft room in round 8 of 10: the pick clock at 26s, the opponent on the clock, and a full nine-player roster"
    >
      Expo on iOS, <span class="nowrap">mid-draft.</span> The pick clock reads 26s.
    </Figure>
  </Chapter>

  <p class="closing">
    Gridiron Duels is live at
    <a href={gridiron.site.href} target="_blank" rel="noopener">{gridiron.site.name}</a>.
    For the architectural deep-dive, read the companion essay
    <a href={gridiron.essay}>in the blog</a>.
  </p>

  <PrevNext {...neighbours(gridiron.slug)} />
</ArticleLayout>

<style>
  /* Gridiron's own pieces, colored from the sky theme. */

  /* The centred phone caption would split "mid-draft" at its hyphen. */
  .nowrap {
    white-space: nowrap;
  }

  /* ---------- Format × modifiers --------------------------------------- */
  .formula {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 6px 14px;
    margin: 28px 0 8px;
    padding: 26px 20px;
    border-radius: 8px;
    border: 1px solid rgb(var(--fg-rgb) / 0.1);
    background: rgb(var(--fg-rgb) / 0.03);
  }

  .formula-side {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .formula-token {
    padding: 2px 4px 6px;
    border-bottom: 1px solid rgb(var(--fg-rgb) / 0.2);
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--fg);
  }

  .formula-result {
    border-bottom: 2px solid var(--accent);
    font-weight: 700;
    color: var(--accent);
  }

  .formula-op {
    font-size: 21px;
    color: var(--muted);
  }

  /* ---------- Services ------------------------------------------------- */
  .services {
    display: grid;
    gap: 12px;
    margin: 28px 0 8px;
  }

  .service {
    position: relative;
    padding: 18px 20px 20px;
    border-radius: 8px;
    border: 1px solid rgb(var(--fg-rgb) / 0.1);
    border-top: 2px solid rgb(var(--accent-rgb) / 0.7);
    background: rgb(var(--fg-rgb) / 0.03);
  }

  .service-n {
    position: absolute;
    top: 18px;
    right: 20px;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }

  .service h3 {
    margin: 0 1.6em 6px 0;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .service p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  /* The window body is the size container, so these follow the window, not the screen. */
  @container (min-width: 560px) {
    .services {
      grid-template-columns: 1fr 1fr;
    }

    /* Five cards: the last one takes the whole row rather than half of it. */
    .service:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* A 320px phone: "CosmeticShopService" and "Format × Modifier set" each still fit on one line. */
  @container (max-width: 400px) {
    .formula {
      padding-inline: 12px;
    }

    .formula-token {
      font-size: 19px;
    }

    .formula-op {
      font-size: 18px;
    }

    .service h3 {
      font-size: 17.5px;
    }
  }
</style>
