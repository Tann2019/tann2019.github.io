---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    role: 'Support Engineer',
    company: 'Givebutter',
    location: 'Remote',
    period: 'Oct 2025 — Present',
    bullets: [
      'Strengthen a global nonprofit CRM and fundraising platform by contributing to feature development, system maintenance, and reliability improvements across the stack.',
      'Monitor, triage, and escalate platform incidents with a focus on rapid root-cause identification, clear communication, and minimizing customer impact.',
      'Build internal tools and automation that streamline support workflows, reduce ticket volume, and improve team response times.',
    ],
  },
  {
    role: 'Programmer',
    company: 'Computers Unlimited',
    location: 'Billings, MT',
    period: 'Jun 2024 — Oct 2025',
    bullets: [
      'Contributed to the development and maintenance of an enterprise mobile app alongside an industry-leading ERP solution for over 8,000 devices.',
      'Communicated with team members through Atlassian products like Jira and Bitbucket, to create tasks and pull requests.',
    ],
  },
  {
    role: 'Software Engineer',
    company: 'Software Design Associates',
    location: 'Billings, MT',
    period: 'Jan 2022 — Jun 2024',
    bullets: [
      'Heavily contributed to the development of the Fence Cloud software suite. Helped build robust and scalable solutions that empower 600+ clients.',
      'Created a scalable middleware for customers to integrate with Zapier, introducing authentication and REST standards to the infrastructure.',
      'Played an innovative role in launching Fence Cloud, in-house cloud-based software using Microsoft Azure.',
    ],
  },
];

const skills = [
  { category: 'Backend', items: ['Laravel', 'PHP', 'PostgreSQL', 'MySQL', 'Redis', 'WebSockets', 'Stripe'] },
  { category: 'Frontend', items: ['React', 'Inertia.js', 'Tailwind CSS', 'Framer Motion', 'Alpine.js'] },
  { category: 'Mobile', items: ['Expo', 'React Native', 'NativeWind', 'Zustand'] },
  { category: 'Tooling', items: ['Vite', 'Azure DevOps', 'GitHub Actions', 'PHPStan', 'Laravel Pint'] },
];

const moreProjects = [
  {
    name: 'HourCrew',
    subtitle: 'Photo-a-Day with Friends',
    stack: 'Expo · Next.js · PostgreSQL · S3 · Turborepo',
    desc: 'Mobile + backend monorepo for taking a photo every hour with your crew. Shared TypeScript package handles types, Zod schemas, and hour-window math across both apps.',
    tag: 'Private',
  },
  {
    name: 'Mort',
    subtitle: 'Personal AI Assistant',
    stack: 'Telegram · Groq · Claude · Raspberry Pi',
    desc: 'Local-first AI assistant over Telegram. Acts as an autonomous dev agent that spawns Claude Code to write full PRs across repos, plus chat, reminders, notes, and proactive check-ins.',
    tag: 'Private',
  },
  {
    name: 'Montarev',
    subtitle: 'Notion ↔ Discord Integration',
    stack: 'Node.js · Notion API · discord.js · PostgreSQL',
    desc: 'Bidirectional sync — Notion task webhooks create Discord embeds and threads, and a /update slash command appends structured update blocks back to the Notion page.',
    tag: 'Private',
  },
  {
    name: 'DnD Mothership',
    subtitle: 'Tabletop Companion System',
    stack: 'ESP32 · LVGL · Node.js · WebSockets',
    desc: 'Each player carries a 3.5" ESP32 touchscreen showing stats, HP, and spell slots; a Node.js mothership on the DM’s laptop pushes live updates from a web dashboard.',
    tag: 'Private',
  },
  {
    name: 'StreamCode.Live',
    subtitle: 'Developer Streaming Platform',
    stack: 'Laravel · Blade',
    desc: 'Live-streaming platform for developers — auth, stream creation/editing, watch pages, and live chat messaging.',
    tag: 'Private',
  },
  {
    name: 'HyGambling',
    subtitle: 'Hytale Casino Plugin',
    stack: 'Java · Hytale Server Core',
    desc: 'Server-side casino plugin — loot boxes, 3-reel slots with up to 100x multipliers, full roulette wheel, per-player UUID-persisted balance, casino NPCs, and admin controls.',
    tag: 'Private',
  },
  {
    name: 'Tech News Gram',
    subtitle: 'Automated Short-Form Video Generator',
    stack: 'Python · ElevenLabs · Whisper · FFmpeg',
    desc: 'Pulls tech news, generates voiceover with ElevenLabs, transcribes with Whisper for SRT subtitles, composites the video with FFmpeg, and uploads to TikTok automatically.',
    href: 'https://github.com/Tann2019/tech-news-gram',
    tag: 'Public',
  },
  {
    name: 'Gundam TCG Deck Builder',
    subtitle: 'Card Search & Deck Builder',
    stack: 'Laravel 11 · Livewire · Tailwind · MongoDB',
    desc: 'Prototype web app for Gundam Trading Card Game enthusiasts to search cards and build decks. Dark space-themed UI.',
    href: 'https://github.com/Tann2019/Gundam',
    tag: 'Public',
  },
  {
    name: 'Zed Blade Support',
    subtitle: 'Editor Extension',
    stack: 'Scheme · tree-sitter-blade',
    desc: 'Adds Laravel Blade syntax highlighting to the Zed editor.',
    href: 'https://github.com/Tann2019/zed-blade-support',
    tag: 'Public',
  },
  {
    name: 'MT Programmers Bot',
    subtitle: 'Community Discord Bot',
    stack: 'discord.js · @sern/handler · Puppeteer',
    desc: 'Discord bot for the Montana Programmers community, with headless-browser scraping support.',
    href: 'https://github.com/Tann2019/MTProgrammersDiscordBot',
    tag: 'Public',
  },
  {
    name: 'NBA Scraper',
    subtitle: 'Stats Web App',
    stack: 'Flask · BeautifulSoup',
    desc: 'Flask web app that scrapes team stats from basketball-reference.com and renders them as an HTML table.',
    href: 'https://github.com/Tann2019/NBA-Scraper',
    tag: 'Public',
  },
  {
    name: 'RPi Dashboard',
    subtitle: 'Pi-Hosted Dashboard',
    stack: 'Next.js',
    desc: 'Next.js dashboard application running on a Raspberry Pi.',
    tag: 'Private',
  },
  {
    name: 'Godot — Hello',
    subtitle: 'First Godot Project',
    stack: 'Godot · HTML5 Export',
    desc: 'A small particle/text demo exported to the web via the Godot HTML5 export.',
    href: 'https://tann2019.github.io/Godot--Hello/',
    tag: 'Public',
  },
  {
    name: 'Advent of Code',
    subtitle: 'Puzzle Solutions',
    stack: 'PHP',
    desc: 'Personal solutions to Advent of Code puzzles, written in PHP.',
    href: 'https://github.com/Tann2019/advent-of-code',
    tag: 'Public',
  },
];
---

<BaseLayout title="Tanner Steorts — Software Engineer">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-label animate-in">Software Engineer</div>
    <h1 class="hero-title animate-in" style="animation-delay: 0.1s">
      Tanner<br />Steorts
    </h1>
    <p class="hero-description animate-in" style="animation-delay: 0.2s">
      Full-stack developer specializing in Laravel + React applications with
      real-time capabilities. I build products that are fast, polished, and fun to use.
    </p>
    <div class="hero-meta animate-in" style="animation-delay: 0.3s">
      <span>Billings, MT</span>
      <span class="meta-dot"></span>
      <a href="mailto:tanner.steorts@icloud.com">tanner.steorts@icloud.com</a>
      <span class="meta-dot"></span>
      <a href="https://github.com/Tann2019" target="_blank" rel="noopener">GitHub</a>
    </div>
  </section>

  <!-- Experience -->
  <section class="section">
    <div class="section-header animate-in">
      <span class="section-number">01</span>
      <h2>Experience</h2>
    </div>
    <div class="timeline">
      {experience.map((job, i) => (
        <div class="timeline-item animate-in" style={`animation-delay: ${0.1 * (i + 1)}s`}>
          <div class="timeline-marker"></div>
          <div class="timeline-meta">
            <span class="timeline-period">{job.period}</span>
            <span class="timeline-location">{job.location}</span>
          </div>
          <div class="timeline-content">
            <h3>{job.role}</h3>
            <span class="timeline-company">{job.company}</span>
            <ul>
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Projects -->
  <section class="section">
    <div class="section-header animate-in">
      <span class="section-number">02</span>
      <h2>Projects</h2>
    </div>

    <div class="projects-grid">
      <a href="https://gridiron-duels.com/" target="_blank" rel="noopener" class="project-card project-card--featured animate-in" style="animation-delay: 0.15s">
        <div class="project-top">
          <span class="project-tag">Featured</span>
          <span class="project-tech">Laravel &middot; React &middot; Expo &middot; WebSockets &middot; Stripe</span>
        </div>
        <h3 class="project-title">Gridiron Duels</h3>
        <p class="project-subtitle">Real-Time Fantasy Football Draft Platform</p>
        <div class="project-details">
          <div class="project-detail">
            <span class="detail-label">Architecture</span>
            <p>Service-oriented backend with dedicated engines for draft orchestration, CPU AI with configurable difficulty, scoring logic, and event-driven post-game hooks.</p>
          </div>
          <div class="project-detail">
            <span class="detail-label">Scale</span>
            <p>Multiple game modes — Classic 1v1, League (up to 16 players), VS CPU, Crazy Mode, Time Machine past seasons, and Weekly Challenges across all 18 NFL weeks.</p>
          </div>
          <div class="project-detail">
            <span class="detail-label">Real-Time</span>
            <p>WebSocket infrastructure for live draft turns, spectating, presence-aware global chat, leaderboard updates, battle pass, cosmetics system, and Stripe-powered coin shop.</p>
          </div>
        </div>
        <span class="project-link">gridiron-duels.com &rarr;</span>
      </a>

      <div class="projects-secondary">
        <a href="https://github.com/Tann2019/twitch-codes" target="_blank" rel="noopener" class="project-card project-card--small animate-in" style="animation-delay: 0.25s">
          <span class="project-tag">VS Code Extension</span>
          <h3 class="project-title-sm">Twitch Codes</h3>
          <p class="project-desc">A VS Code extension that bridges Twitch chat with your editor. Viewers highlight lines, suggest and vote on code changes, and scroll the editor — all via chat commands.</p>
        </a>

        <a href="https://github.com/Tann2019/tann2019.github.io" target="_blank" rel="noopener" class="project-card project-card--small animate-in" style="animation-delay: 0.3s">
          <span class="project-tag">This Site</span>
          <h3 class="project-title-sm">Personal Website</h3>
          <p class="project-desc">Portfolio and blog built with Astro. Static, fast, and deployed to GitHub Pages.</p>
        </a>
      </div>
    </div>

    <div class="more-header animate-in">
      <span class="more-label">More</span>
      <span class="more-rule"></span>
    </div>

    <div class="more-grid">
      {moreProjects.map((proj, i) => {
        const Tag = proj.href ? 'a' : 'div';
        const props = proj.href ? { href: proj.href, target: '_blank', rel: 'noopener' } : {};
        return (
          <Tag class="more-card animate-in" style={`animation-delay: ${0.05 * (i + 1)}s`} {...props}>
            <div class="more-card-top">
              <h3 class="more-card-title">{proj.name}</h3>
              <span class={`more-card-tag more-card-tag--${proj.tag.toLowerCase()}`}>{proj.tag}</span>
            </div>
            <p class="more-card-subtitle">{proj.subtitle}</p>
            <p class="more-card-desc">{proj.desc}</p>
            <span class="more-card-stack">{proj.stack}</span>
          </Tag>
        );
      })}
    </div>
  </section>

  <!-- Skills -->
  <section class="section">
    <div class="section-header animate-in">
      <span class="section-number">03</span>
      <h2>Toolkit</h2>
    </div>
    <div class="skills-categories">
      {skills.map((group, i) => (
        <div class="skill-category animate-in" style={`animation-delay: ${0.1 * (i + 1)}s`}>
          <span class="skill-category-label">{group.category}</span>
          <div class="skills-grid">
            {group.items.map((skill) => (
              <span class="skill-tag">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 6rem 0 5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 5rem;
  }

  .hero-label {
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 2rem;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 36rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  .meta-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-dim);
  }

  .hero-meta a {
    color: var(--text-dim);
  }

  .hero-meta a:hover {
    color: var(--accent);
  }

  /* Sections */
  .section {
    margin-bottom: 5rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .section-number {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--accent);
    font-style: italic;
  }

  .section-header h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 12px 11rem 1fr;
    gap: 0 2rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border);
    position: relative;
  }

  .timeline-marker {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 0.45rem;
    position: relative;
  }

  .timeline-marker::after {
    content: '';
    position: absolute;
    top: 8px;
    left: 3px;
    width: 1px;
    height: calc(100% + 2rem);
    background: var(--border);
  }

  .timeline-item:last-child .timeline-marker::after {
    display: none;
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .timeline-period {
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
    font-weight: 400;
  }

  .timeline-location {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .timeline-content h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .timeline-company {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--accent);
    margin-bottom: 1rem;
    font-weight: 400;
  }

  .timeline-content ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .timeline-content li {
    font-size: 0.95rem;
    color: var(--text-muted);
    padding-left: 1rem;
    position: relative;
    line-height: 1.6;
  }

  .timeline-content li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65rem;
    width: 4px;
    height: 1px;
    background: var(--text-dim);
  }

  /* Projects */
  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2.5rem;
    transition: border-color 0.3s ease;
    display: block;
    color: var(--text);
  }

  .project-card:hover {
    border-color: var(--border-hover);
    color: var(--text);
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .project-tag {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(200, 149, 108, 0.08);
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    font-weight: 500;
  }

  .project-tech {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .project-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .project-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .detail-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .project-detail p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .project-link {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--accent);
    font-weight: 400;
    transition: gap 0.2s ease;
  }

  .project-card--featured:hover .project-link {
    color: var(--accent-glow);
  }

  .projects-secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .project-card--small {
    padding: 2rem;
  }

  .project-card--small .project-tag {
    display: inline-block;
    margin-bottom: 1rem;
  }

  .project-title-sm {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  .project-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* More projects */
  .more-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 4rem 0 1.75rem;
  }

  .more-label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    font-style: italic;
  }

  .more-rule {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .more-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--text);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  a.more-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    color: var(--text);
  }

  .more-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .more-card-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .more-card-tag {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    font-weight: 500;
    white-space: nowrap;
  }

  .more-card-tag--public {
    color: var(--accent);
    background: rgba(200, 149, 108, 0.08);
  }

  .more-card-tag--private {
    color: var(--text-dim);
    background: var(--bg-card);
    border: 1px solid var(--border);
  }

  .more-card-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .more-card-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0.25rem 0 0.5rem;
  }

  .more-card-stack {
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.02em;
    margin-top: auto;
  }

  /* Skills */
  .skills-categories {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .skill-category {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .skill-category-label {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 500;
    min-width: 5.5rem;
    padding-top: 0.65rem;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-tag {
    font-size: 0.85rem;
    color: var(--text);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 0.5rem 1.1rem;
    border-radius: 100px;
    font-weight: 400;
    transition: all 0.3s ease;
  }

  .skill-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 3rem;
      margin-bottom: 3rem;
    }

    .hero-meta {
      flex-wrap: wrap;
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding-left: 1.5rem;
    }

    .timeline-marker {
      position: absolute;
      left: 0;
      top: 2.35rem;
    }

    .timeline-marker::after {
      display: none;
    }

    .project-card {
      padding: 1.5rem;
    }

    .project-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .project-details {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .projects-secondary {
      grid-template-columns: 1fr;
    }

    .more-grid {
      grid-template-columns: 1fr;
    }

    .skill-category {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
