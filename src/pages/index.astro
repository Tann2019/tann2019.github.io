---
// The homepage: a Linux-style desktop themed live from the sky over Billings. See REDESIGN.md.
// Every window's content is rendered here at build time, so it reads without JavaScript too.
import { Picture } from 'astro:assets';
import Seo from '../components/Seo.astro';
import '../redesign/styles.css';
import { APPS, LOCK_KEY } from '../redesign/windows';
import Win from '../redesign/Win.astro';
import FileIcon from '../redesign/FileIcon.astro';
import RestoreTheme from '../redesign/RestoreTheme.astro';
import Wallpaper from '../redesign/Wallpaper.astro';
import PostList from '../redesign/PostList.astro';
import WorkHistory from '../redesign/WorkHistory.astro';
import Synth from '../redesign/apps/Synth.astro';
import Guestbook from '../redesign/apps/Guestbook.astro';
import { currentJob, desktopIcons, sideProjects } from '../redesign/content';
import { caseStudies } from '../data/case-studies';
import { disdubs } from '../data/disdubs';
import { gridiron } from '../data/gridiron';
import { getPosts } from '../data/posts';

const posts = await getPosts();

// --------------------------------------------------------------- neofetch
// Original ASCII: the Beartooths and the Rims. Each segment is [ink, text].
const art: [string, string][][] = [
  [['s', '           *        .        ']],
  [['s', '     .     '], ['m', '   /\\'], ['s', '        *    ']],
  [['m', '      /\\     /'], ['w', '**'], ['m', '\\']],
  [['m', '     /'], ['w', '**'], ['m', '\\   /    \\       ']],
  [['m', '    /    \\_/      \\'], ['r', '______']],
  [['m', ' __/    '], ['r', '_____________'], ['r', '|||||']],
  [['r', ' /     /|||||||||||||'], ['r', '||||\\']],
  [['g', '/_____/'], ['r', '||||||||||||||||'], ['g', '_\\']],
  [['v', '~~~~~~~~~~~~~~~~~~~~~~~~~~~~']],
];
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const artHtml = art.map((line) => line.map(([ink, text]) => `<span class="nf-${ink}">${esc(text)}</span>`).join('')).join('\n');

const launcherEntries = [
  { id: 'terminal', name: 'Terminal', desc: 'neofetch and a shell', icon: 'terminal' },
  ...caseStudies.map((s) => ({ id: s.app, name: s.title, desc: s.launcher, icon: s.icon })),
  { id: 'mothership', name: 'DnD Mothership', desc: 'Screens for D&D', icon: 'd20' },
  { id: 'work', name: 'Work history', desc: 'Jobs and toolkit', icon: 'clipboard' },
  { id: 'side', name: 'Side projects', desc: 'Smaller builds', icon: 'tacklebox' },
  { id: 'writing', name: 'Writing', desc: 'Blog posts', icon: 'notebook' },
  { id: 'chess', name: 'Chess', desc: 'Play Mort', icon: 'knight' },
  { id: 'synth', name: 'Synth', desc: 'Play notes', icon: 'synth' },
  { id: 'guestbook', name: 'Sticky notes', desc: 'Leave a note', icon: 'stickynote' },
  { id: 'radio', name: 'Lofi radio', desc: 'Music', icon: 'vinyl' },
  { id: 'sayhi', name: 'Say hi', desc: 'Email', icon: 'mailbox' },
  { id: 'tile', name: 'Tile windows', desc: 'Arrange side by side', icon: 'folder' },
  { id: 'lock', name: 'Lock screen', desc: 'Back to the clock', icon: 'lock' },
];
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <Seo
      title="Tanner Steorts, software engineer in Billings, Montana"
      description="Tanner Steorts builds real-time apps from Billings, Montana. Open his case studies, work history and writing as windows on a desktop under the live sky."
      schema={[
        {
          '@type': 'ProfilePage',
          '@id': 'https://tannersteorts.com/#profile',
          url: 'https://tannersteorts.com/',
          name: 'Tanner Steorts, software engineer in Billings, Montana',
          inLanguage: 'en-US',
          isPartOf: { '@id': 'https://tannersteorts.com/#website' },
          mainEntity: { '@id': 'https://tannersteorts.com/#person' },
          /* The Big Sky launch, or the newest post if later: the desktop lists every post. */
          dateModified: new Date(
            Math.max(
              Date.parse('2026-10-19T10:59:02-06:00'),
              ...posts.map((p) => (p.data.updatedDate ?? p.data.pubDate).valueOf())
            )
          ).toISOString(),
        },
        {
          '@type': 'ItemList',
          '@id': 'https://tannersteorts.com/#case-studies',
          name: 'Case studies',
          itemListElement: caseStudies.map((s, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: s.title,
            url: `https://tannersteorts.com${s.href}`,
          })),
        },
      ]}
    />
    <meta name="theme-color" content="#1f5fb6" />
    <RestoreTheme />
    {/* A visitor wm.ts will let straight in (already unlocked this session, or linked to a window) never sees a frame of
        the lock screen first. setupLock makes the same call, then takes over. See .skip-lock in styles.css. */}
    <script is:inline define:vars={{ lockKey: LOCK_KEY, apps: Object.keys(APPS) }}>
      let skip = apps.includes(location.hash.slice(1));
      try {
        skip = skip || sessionStorage.getItem(lockKey) === '1';
      } catch {}
      if (skip) document.documentElement.classList.add('skip-lock');
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=National+Park:wght@400..800&family=Overpass:ital,wght@0,300..800;1,400&family=Overpass+Mono:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="/classic/">Skip to the plain site</a>

    <!-- ============================== WALLPAPER ============================== -->
    <Wallpaper />

    <!-- ================================ DESKTOP ================================ -->
    <div id="desktop">
      <div class="conky">
        <h1 class="conky-name">Tanner Steorts</h1>
        <p class="conky-intro">Software engineer in Billings, Montana. I build real-time things people use together.</p>

        <div class="conky-sky">
          <p class="conky-time"><span id="conky-time">–:––</span><span class="conky-ampm" id="conky-ampm"></span></p>
          <p class="conky-day" id="conky-day">Billings, Montana</p>
          <p class="conky-phase"><span id="conky-phase"></span>. <span id="conky-sun"></span>.<span id="conky-weather"></span></p>
          <div class="scrub">
            <label class="scrub-label" for="sky-scrub">Change the time of day</label>
            <input type="range" id="sky-scrub" min="0" max="1439" step="1" value="720" />
            <div class="scrub-ticks" aria-hidden="true"><span>12 AM</span><span>6 AM</span><span>Noon</span><span>6 PM</span><span>12 AM</span></div>
            <button class="scrub-live" id="sky-live" type="button" hidden>Back to live</button>
          </div>
        </div>
      </div>

      <nav class="dicons" aria-label="Desktop">
        {desktopIcons.map((d) => (
          <button class="dicon" type="button" data-app={d.app} aria-label={`Open ${d.label}`}>
            <FileIcon name={d.icon} />
            <span class="dicon-name">{d.name}</span>
          </button>
        ))}
      </nav>
      <p class="desk-hint"><span class="hint-mouse">Double-click to open. Drag to move.</span><span class="hint-touch">Tap to open.</span></p>
    </div>
    <div id="marquee" hidden></div>
    <div id="snap-preview" hidden></div>

    <!-- ================================= BAR ================================= -->
    <header class="bar" id="bar">
      <div class="bar-left">
        <button class="bar-icon bar-launch" id="bar-launch" type="button" aria-label="Open the app launcher" aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="16.5" cy="7.5" r="3"></circle><path d="M2 19l3.6-7h12.8l3.6 7z"></path></svg>
        </button>
        <nav class="bar-ws" aria-label="Workspaces">
          {[1, 2, 3, 4].map((n) => (
            <button type="button" data-ws-btn={n} aria-label={`Workspace ${n}`}>{n}</button>
          ))}
        </nav>
      </div>
      <div class="taskbar" id="taskbar" role="group" aria-label="Open windows"></div>
      <div class="bar-right">
        <button class="bar-icon" id="bar-tile" type="button" aria-label="Tile windows" title="Tile windows">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="9" height="15" rx="1.5"></rect><rect x="14.5" y="4.5" width="6" height="6.5" rx="1.5"></rect><rect x="14.5" y="13" width="6" height="6.5" rx="1.5"></rect></svg>
        </button>
        <button id="bar-presence" type="button" hidden></button>
        <span class="bar-weather" id="bar-weather" hidden></span>
        <button class="bar-sun" id="bar-sun" type="button">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="4.5"></circle><path d="M3 20h18"></path></svg>
          <span id="bar-sun-text"></span><span class="sr-only">. Change the time of day</span>
        </button>
        <span class="bar-clock" id="bar-clock"></span>
        <button class="bar-icon bar-lock" id="bar-lock" type="button" aria-label="Lock the screen">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
        </button>
      </div>
    </header>

    <!-- ============================== WORKSPACES ============================== -->
    <main id="workspaces">
      {[1, 2, 3, 4].map((n) => <section class="ws" data-ws={n} aria-label={`Workspace ${n}`}></section>)}
    </main>
    <div id="float-layer"></div>

    <!-- ===================== WINDOWS, MOVED IN WHEN OPENED ===================== -->
    <div id="win-pool" hidden>
      <Win app="terminal" title="tanner@billings: ~" label="Terminal">
        <div class="term" data-studies={JSON.stringify(caseStudies.map((s) => [s.slug, s.app]))} data-job={currentJob}>
          <div class="term-out" aria-live="polite">
            <div class="term-line"><span class="term-prompt">tanner@billings <b>~</b> $</span> neofetch</div>
            <div class="neofetch">
              <pre class="nf-art" aria-hidden="true" set:html={artHtml}></pre>
              <dl class="nf-info">
                <div class="nf-head"><span>tanner</span>@<span>billings</span></div>
                <div class="nf-rule" aria-hidden="true">────────────────</div>
                <div><dt>OS</dt><dd>Big Sky Linux</dd></div>
                <div><dt>Host</dt><dd>Billings, Montana</dd></div>
                <div><dt>Uptime</dt><dd data-live="uptime">shipping since 2022</dd></div>
                <div><dt>Role</dt><dd>{currentJob}</dd></div>
                <div><dt>Building</dt><dd>Gridiron Duels</dd></div>
                <div><dt>Shipped</dt><dd>{disdubs.title}, {disdubs.stats[0].value} servers in month one</dd></div>
                <div><dt>Stack</dt><dd>Laravel, React, Expo, TypeScript</dd></div>
                <div><dt>School</dt><dd>B.S. Computer Science, Rocky Mountain College</dd></div>
                <div><dt>Sky</dt><dd data-live="sky"></dd></div>
                <div class="nf-swatches" role="img" aria-label="Theme palette, sampled from the wallpaper right now">
                  {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <span style={`background: var(--c${i})`}></span>)}
                </div>
              </dl>
            </div>
          </div>
          <form class="term-form" autocomplete="off">
            <label class="term-prompt" for="term-input">tanner@billings <b>~</b> $</label>
            <input id="term-input" class="term-input" data-autofocus spellcheck="false" autocapitalize="off" placeholder="type help, then Enter" />
          </form>
        </div>
      </Win>

      <Win app={disdubs.app} title={disdubs.title}>
        <article class="doc">
          <h2 class="doc-title">{disdubs.title}</h2>
          <p class="doc-lede">{disdubs.window.lede}</p>
          <p class="doc-meta">{disdubs.window.meta}</p>

          <ul class="stats">
            {disdubs.window.stats.map((s) => (
              <li><strong>{s.value}</strong><span>{s.label}</span></li>
            ))}
          </ul>

          <h3>How a dub gets made</h3>
          <ol class="reel">
            {disdubs.reel.map((r) => (
              <li>
                {/* Thumbnails about 190px wide, or half a phone sheet. */}
                <Picture src={r.img} alt={r.alt} formats={['avif', 'webp']} fallbackFormat="webp" width={320} widths={[320, 640]} sizes="(max-width: 760px) 45vw, 190px" loading="lazy" />
                <span>{r.title}</span>
              </li>
            ))}
          </ol>

          <h3>No microphone allowed</h3>
          <p>
            Discord Activities can’t use the mic, so a bot in the voice channel records instead. Each
            performer gets their own track on a shared timeline. A flubbed line costs one line, not the take.
          </p>

          <div class="doc-actions">
            <a class="btn btn-primary" href={disdubs.href}>Read the case study</a>
            <a class="btn" href={disdubs.site.href} target="_blank" rel="noopener">{disdubs.site.name}</a>
          </div>
        </article>
      </Win>

      <Win app={gridiron.app} title={gridiron.title}>
        <article class="doc">
          <h2 class="doc-title">{gridiron.title}</h2>
          <p class="doc-lede">{gridiron.window.lede}</p>
          <p class="doc-meta">{gridiron.window.meta}</p>
          <dl class="facts">
            <div>
              <dt>Architecture</dt>
              <dd>Separate engines for drafting, CPU opponents, scoring and post-game hooks.</dd>
            </div>
            <div>
              <dt>Game modes</dt>
              <dd>1v1, 16-player leagues, versus CPU, Crazy Mode, past seasons, weekly challenges.</dd>
            </div>
            <div>
              <dt>Real time</dt>
              <dd>WebSockets for draft turns, spectating, chat and leaderboards. Battle pass and a Stripe coin shop on top.</dd>
            </div>
          </dl>
          <div class="doc-actions">
            <a class="btn btn-primary" href={gridiron.href}>Read the case study</a>
            <a class="btn" href={gridiron.site.href} target="_blank" rel="noopener">{gridiron.site.name}</a>
          </div>
        </article>
      </Win>

      <Win app="mothership" title="DnD Mothership">
        <article class="doc">
          <h2 class="doc-title">DnD Mothership</h2>
          <p class="doc-lede">Each player gets a $20 ESP32 touchscreen with HP and spell slots. The DM edits from a laptop; screens update in under 100 ms.</p>
          <p class="doc-meta">ESP32, LVGL, Node.js, WebSockets.</p>
          <div class="doc-actions">
            <a class="btn btn-primary" href="/blog/dnd-mothership/">Read the write-up</a>
          </div>
        </article>
      </Win>

      <Win app="work" title="Work history">
        <article class="doc">
          <h2 class="doc-title">Work history</h2>
          <WorkHistory />
          <div class="doc-actions">
            <a class="btn btn-primary" href="/about/">More about me</a>
          </div>
        </article>
      </Win>

      <Win app="side" title="Side projects">
        <article class="doc">
          <h2 class="doc-title">Side projects</h2>
          <ul class="side-list">
            {sideProjects.map((p) => (
              <li>
                <h3>{p.href ? <a href={p.href} target="_blank" rel="noopener">{p.name}</a> : p.name}</h3>
                <p>{p.what}</p>
                <p class="doc-meta">{p.stack}{p.href ? '' : '. Private repo.'}</p>
              </li>
            ))}
          </ul>
        </article>
      </Win>

      <Win app="writing" title="Writing">
        <article class="doc">
          <h2 class="doc-title">Writing</h2>
          <PostList posts={posts} />
          <div class="doc-actions">
            <a class="btn btn-primary" href="/blog/">All writing</a>
          </div>
        </article>
      </Win>

      <Win app="chess" title="Chess">
        <div class="cb">
          <div class="cb-board-wrap">
            <div class="cb-board" role="group" aria-label="Chess board. You play white. Arrow keys move between squares, Enter picks up and drops a piece."></div>
          </div>
          <aside class="cb-side">
            <div class="cb-mort">
              <p class="cb-mort-name">Mort</p>
              <p class="cb-mort-about">My AI assistant. Plays black, thinks three moves ahead.</p>
              <div class="cb-taken cb-taken-mort" aria-label="Pieces Mort has taken"></div>
            </div>
            <p class="cb-mort-line" aria-live="polite">You move first.</p>
            <p class="cb-status" role="status">Your move.</p>
            <ol class="cb-moves" aria-label="Moves so far"></ol>
            <div class="cb-taken cb-taken-you" aria-label="Pieces you have taken"></div>
            <div class="cb-actions">
              <button class="btn" type="button" data-chess="undo">Undo move</button>
              <button class="btn btn-primary" type="button" data-chess="new">New game</button>
            </div>
          </aside>
        </div>
      </Win>

      <Win app="synth" title="Synth">
        <Synth />
      </Win>

      <Win app="guestbook" title="Sticky notes">
        <Guestbook />
      </Win>

      <Win app="radio" title="lofi radio" label="Lofi radio">
        <div class="radio">
          <div class="radio-screen">
            <iframe
              data-src="https://lofi.srizan.dev/?embed=1&volume=15"
              title="lofi.srizan.dev player"
              allow="autoplay; encrypted-media; picture-in-picture"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
          <div class="radio-deck" hidden>
            <img class="radio-cover" alt="" width="36" height="36" hidden />
            <button class="radio-btn" type="button" data-radio="toggle" aria-label="Play" aria-pressed="false">
              <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z"></path></svg>
              <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3.5h2.5v9H4.5zM9 3.5h2.5v9H9z"></path></svg>
            </button>
            <button class="radio-btn" type="button" data-radio="next" aria-label="Next track">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5v9l6-4.5zM10.5 3.5h2v9h-2z"></path></svg>
            </button>
            <p class="radio-now" aria-live="polite">Ready</p>
            <label class="radio-vol">
              <span class="sr-only">Volume</span>
              <input type="range" min="0" max="100" value="15" data-radio="volume" />
            </label>
          </div>
          <p class="radio-credit">
            <a href="https://lofi.srizan.dev/" target="_blank" rel="noopener">lofi.srizan.dev</a> by SrIzan10, open source.
            Minimize to keep listening.
          </p>
        </div>
      </Win>

      <Win app="sayhi" title="Say hi">
        <div class="hi">
          <p>Email is the fastest way to reach me.</p>
          <p class="hi-addr">tanner.steorts@icloud.com</p>
          <div class="doc-actions">
            <a class="btn btn-primary" href="mailto:tanner.steorts@icloud.com" data-autofocus>Write an email</a>
            <button class="btn" type="button" data-copy="tanner.steorts@icloud.com">Copy address</button>
          </div>
          <p class="hi-more"><a href="https://github.com/Tann2019" target="_blank" rel="noopener">GitHub</a></p>
        </div>
      </Win>
    </div>

    <template id="tpl-neofetch">
      <div class="neofetch">
        <pre class="nf-art" aria-hidden="true" set:html={artHtml}></pre>
        <dl class="nf-info">
          <div class="nf-head"><span>tanner</span>@<span>billings</span></div>
          <div><dt>Host</dt><dd>Billings, Montana</dd></div>
          <div><dt>Role</dt><dd>{currentJob}</dd></div>
          <div><dt>Building</dt><dd>Gridiron Duels</dd></div>
          <div><dt>Sky</dt><dd data-live="sky"></dd></div>
          <div class="nf-swatches" role="img" aria-label="Theme palette, sampled from the wallpaper right now">
            {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <span style={`background: var(--c${i})`}></span>)}
          </div>
        </dl>
      </div>
    </template>

    <!-- =============================== LAUNCHER =============================== -->
    <div class="launcher-scrim" id="launcher" hidden>
      <div class="launcher" role="dialog" aria-modal="true" aria-label="Open an app">
        <input
          id="launcher-input"
          class="launcher-input"
          type="text"
          placeholder="Search apps"
          role="combobox"
          aria-expanded="true"
          aria-controls="launcher-list"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
        />
        <ul class="launcher-list" id="launcher-list" role="listbox" aria-label="Apps" tabindex="-1">
          {launcherEntries.map((e) => (
            <li role="option" id={`launch-${e.id}`} data-launch={e.id} data-terms={`${e.name} ${e.desc} ${e.id}`.toLowerCase()} aria-selected="false">
              <FileIcon name={e.icon} />
              <span class="l-name">{e.name}</span>
              <span class="l-desc">{e.desc}</span>
            </li>
          ))}
        </ul>
        <p class="launcher-empty" id="launcher-empty" hidden>No app by that name.</p>
        <p class="launcher-keys">
          <span><kbd>Alt</kbd>+<kbd>1–4</kbd> workspace</span>
          <span><kbd>Alt</kbd>+<kbd>Enter</kbd> terminal</span>
          <span><kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>Q</kbd> close</span>
          <span><kbd>/</kbd> this list</span>
        </p>
      </div>
    </div>

    <!-- ============================== LOCK SCREEN ============================== -->
    <div class="lock" id="lock" role="dialog" aria-modal="true" aria-label="Lock screen">
      <div class="lock-ring-wrap">
        <svg class="lock-ring" viewBox="0 0 220 220" aria-hidden="true">
          <circle class="ring-track" cx="110" cy="110" r="100"></circle>
          <circle class="ring-key" cx="110" cy="110" r="100"></circle>
          <circle class="ring-fill" cx="110" cy="110" r="100"></circle>
        </svg>
        <p class="lock-clock"><span id="lock-time">–:––</span><span class="lock-ampm" id="lock-ampm"></span></p>
      </div>
      <p class="lock-day" id="lock-day"></p>
      <p class="lock-phase" id="lock-phase">Billings, Montana</p>
      <button class="lock-go" id="lock-go" type="button">Unlock</button>
      <p class="lock-hint">or press any key</p>
    </div>

    <script>
      import '../redesign/main.ts';
    </script>
  </body>
</html>
